// The C entry points of libtree-sitter, one novo-lang declaration each.
//
// A pointer is an `Int`: the C API hands out opaque handles for the
// parser, the tree, the language table, the query and the query
// cursor, and this module carries each of them as the address the C
// library returned.  Zero is the null pointer, which is how every
// allocating entry point below reports failure.
//
// A `Str` argument is passed as a NUL-terminated C string, and every
// entry point that takes one also takes its length in bytes, exactly
// as the C function does.
//
// The entry points that pass or return a `TSNode`, a `TSPoint`, a
// `TSRange`, a `TSTreeCursor` or a `TSQueryMatch` by value are not
// here.  The README's "What is not included" section lists them.

// Create a new parser.
//
// The parser has no language until `ts_parser_set_language` assigns
// one.  Zero means the allocation failed.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_new")
fn ts_parser_new() -> Int [ffi]

// Delete the parser, freeing all of the memory that it used.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_delete")
fn ts_parser_delete(parser: Int) [ffi]

// Set the language that the parser should use for parsing.
//
// Returns 1 when the assignment succeeded and 0 when it did not.  A 0
// means a version mismatch: the language was generated with an
// incompatible version of the tree-sitter command line tool.  Compare
// `ts_language_version` with the library's own
// `TREE_SITTER_LANGUAGE_VERSION` to see which.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_set_language")
fn ts_parser_set_language(parser: Int, language: Int) -> Int [ffi]

// Get the parser's current language.
//
// Zero when no language has been assigned.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_language")
fn ts_parser_language(parser: Int) -> Int [ffi]

// Use the parser to parse some source code stored in one contiguous
// buffer, and create a syntax tree.
//
// Pass 0 for `old_tree` the first time a document is parsed.  Pass the
// previous tree, already edited to match the source changes, to reuse
// the unchanged parts of it.  `length` is the length of the buffer in
// bytes.
//
// Returns a syntax tree, or 0 on failure.  There are three reasons for
// a failure: the parser has no language assigned, the parse hit the
// timeout set by `ts_parser_set_timeout_micros`, or the parse was
// cancelled through the cancellation flag.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_parse_string")
fn ts_parser_parse_string(parser: Int, old_tree: Int, source: Str, length: Int) -> Int [ffi]

// Parse a contiguous buffer with a given encoding.
//
// The first four arguments are those of `ts_parser_parse_string`.
// `encoding` is 0 for UTF-8 and 1 for UTF-16.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_parse_string_encoding")
fn ts_parser_parse_string_encoding(parser: Int, old_tree: Int, source: Str, length: Int,
                                   encoding: Int) -> Int [ffi]

// Instruct the parser to start the next parse from the beginning.
//
// A parser that stopped on a timeout or a cancellation resumes where
// it left off by default.  Call this first to parse a different
// document with the same parser instead.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_reset")
fn ts_parser_reset(parser: Int) [ffi]

// Set the maximum duration in microseconds that parsing should be
// allowed to take before halting.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_set_timeout_micros")
fn ts_parser_set_timeout_micros(parser: Int, timeout: Int) [ffi]

// Get the duration in microseconds that parsing is allowed to take.
pub @ffi(library = "tree-sitter", symbol = "ts_parser_timeout_micros")
fn ts_parser_timeout_micros(parser: Int) -> Int [ffi]

// Create a shallow copy of the syntax tree.
//
// The copy is cheap, and it is how one tree is used from two threads
// at once: each thread needs its own tree.
pub @ffi(library = "tree-sitter", symbol = "ts_tree_copy")
fn ts_tree_copy(tree: Int) -> Int [ffi]

// Delete the syntax tree, freeing all of the memory that it used.
pub @ffi(library = "tree-sitter", symbol = "ts_tree_delete")
fn ts_tree_delete(tree: Int) [ffi]

// Get the language that was used to parse the syntax tree.
pub @ffi(library = "tree-sitter", symbol = "ts_tree_language")
fn ts_tree_language(tree: Int) -> Int [ffi]

// Create a new query from a string containing one or more S-expression
// patterns.
//
// `source_len` is the length of the pattern text in bytes.
// `error_offset` and `error_type` are addresses of two 32-bit slots the
// caller owns.  On a failure the return value is 0, the byte offset of
// the error is written to `error_offset`, and a value describing the
// kind of error is written to `error_type`: 1 for a syntax error, 2 for
// an unknown node type, 3 for an unknown field, 4 for an unknown
// capture, 5 for an impossible pattern structure, and 6 for a language
// error.
pub @ffi(library = "tree-sitter", symbol = "ts_query_new")
fn ts_query_new(language: Int, source: Str, source_len: Int, error_offset: Int,
                error_type: Int) -> Int [ffi]

// Delete the query, freeing all of the memory that it used.
pub @ffi(library = "tree-sitter", symbol = "ts_query_delete")
fn ts_query_delete(query: Int) [ffi]

// Get the number of patterns in the query.
pub @ffi(library = "tree-sitter", symbol = "ts_query_pattern_count")
fn ts_query_pattern_count(query: Int) -> Int [ffi]

// Get the number of captures in the query.
pub @ffi(library = "tree-sitter", symbol = "ts_query_capture_count")
fn ts_query_capture_count(query: Int) -> Int [ffi]

// Get the number of string literals in the query.
pub @ffi(library = "tree-sitter", symbol = "ts_query_string_count")
fn ts_query_string_count(query: Int) -> Int [ffi]

// Get the byte offset where the given pattern starts in the query's
// source.
//
// This is the offset a caller attributes a pattern error to when
// several queries were concatenated into one source string.
pub @ffi(library = "tree-sitter", symbol = "ts_query_start_byte_for_pattern")
fn ts_query_start_byte_for_pattern(query: Int, pattern_index: Int) -> Int [ffi]

// Get the name of one of the query's captures.
//
// The return value is the address of a NUL-terminated C string the
// query owns.  `length` is the address of a 32-bit slot the caller
// owns, and the length of the name in bytes is written to it.
pub @ffi(library = "tree-sitter", symbol = "ts_query_capture_name_for_id")
fn ts_query_capture_name_for_id(query: Int, index: Int, length: Int) -> Int [ffi]

// Get one of the query's string literals.
//
// The return value and `length` work as they do in
// `ts_query_capture_name_for_id`.
pub @ffi(library = "tree-sitter", symbol = "ts_query_string_value_for_id")
fn ts_query_string_value_for_id(query: Int, index: Int, length: Int) -> Int [ffi]

// Disable a capture within a query.
//
// The capture is no longer reported, and the work of computing it is
// no longer done.  This cannot be undone.
pub @ffi(library = "tree-sitter", symbol = "ts_query_disable_capture")
fn ts_query_disable_capture(query: Int, name: Str, length: Int) [ffi]

// Disable a pattern within a query.
//
// The pattern no longer matches, and the work of matching it is no
// longer done.  This cannot be undone.
pub @ffi(library = "tree-sitter", symbol = "ts_query_disable_pattern")
fn ts_query_disable_pattern(query: Int, pattern_index: Int) [ffi]

// Create a new cursor for executing a given query.
//
// The cursor holds the state needed to iterate over the matches.  One
// cursor is reused for many queries, but for only one query at a time.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_new")
fn ts_query_cursor_new() -> Int [ffi]

// Delete the query cursor, freeing all of the memory that it used.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_delete")
fn ts_query_cursor_delete(cursor: Int) [ffi]

// Get the maximum number of in-progress matches the cursor allows.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_match_limit")
fn ts_query_cursor_match_limit(cursor: Int) -> Int [ffi]

// Set the maximum number of in-progress matches the cursor allows.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_set_match_limit")
fn ts_query_cursor_set_match_limit(cursor: Int, limit: Int) [ffi]

// Ask whether the cursor exceeded its maximum number of in-progress
// matches during its last execution.
//
// Returns 1 when it did.  A 1 means the results are incomplete, and
// that a larger match limit would return more of them.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_did_exceed_match_limit")
fn ts_query_cursor_did_exceed_match_limit(cursor: Int) -> Int [ffi]

// Set the range of bytes in which the query will be executed.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_set_byte_range")
fn ts_query_cursor_set_byte_range(cursor: Int, start_byte: Int, end_byte: Int) [ffi]

// Advance to the next match of the currently running query.
//
// `match_out` is the address of a caller-owned `TSQueryMatch`.  Returns
// 1 when a match was written there, and 0 when the matches are
// exhausted.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_next_match")
fn ts_query_cursor_next_match(cursor: Int, match_out: Int) -> Int [ffi]

// Remove a match from the cursor by its identifier.
//
// The match no longer appears in the results.  This is how a caller
// drops a match that its own predicate rejected.
pub @ffi(library = "tree-sitter", symbol = "ts_query_cursor_remove_match")
fn ts_query_cursor_remove_match(cursor: Int, match_id: Int) [ffi]

// Get the number of distinct node types in the language.
pub @ffi(library = "tree-sitter", symbol = "ts_language_symbol_count")
fn ts_language_symbol_count(language: Int) -> Int [ffi]

// Get a node type string for the given numerical identifier.
//
// The return value is the address of a NUL-terminated C string the
// language owns.
pub @ffi(library = "tree-sitter", symbol = "ts_language_symbol_name")
fn ts_language_symbol_name(language: Int, symbol: Int) -> Int [ffi]

// Get the numerical identifier for the given node type string.
//
// `length` is the length of the string in bytes.  `is_named` is 1 for a
// named node type and 0 for an anonymous one, and the two are separate
// sets of names.
pub @ffi(library = "tree-sitter", symbol = "ts_language_symbol_for_name")
fn ts_language_symbol_for_name(language: Int, name: Str, length: Int, is_named: Int) -> Int [ffi]

// Get the number of distinct field names in the language.
pub @ffi(library = "tree-sitter", symbol = "ts_language_field_count")
fn ts_language_field_count(language: Int) -> Int [ffi]

// Get the field name string for the given numerical identifier.
//
// The return value is the address of a NUL-terminated C string the
// language owns.
pub @ffi(library = "tree-sitter", symbol = "ts_language_field_name_for_id")
fn ts_language_field_name_for_id(language: Int, field_id: Int) -> Int [ffi]

// Get the numerical identifier for the given field name string.
//
// `length` is the length of the name in bytes.
pub @ffi(library = "tree-sitter", symbol = "ts_language_field_id_for_name")
fn ts_language_field_id_for_name(language: Int, name: Str, length: Int) -> Int [ffi]

// Check whether the given node type identifier is named, anonymous or
// auxiliary.
//
// Returns 0 for a regular named node type, 1 for an anonymous one and
// 2 for one the parser generated for itself.
pub @ffi(library = "tree-sitter", symbol = "ts_language_symbol_type")
fn ts_language_symbol_type(language: Int, symbol: Int) -> Int [ffi]

// Get the ABI version number for this language.
//
// A parser accepts a language only when the number is between the
// library's `TREE_SITTER_MIN_COMPATIBLE_LANGUAGE_VERSION` and its
// `TREE_SITTER_LANGUAGE_VERSION`.
pub @ffi(library = "tree-sitter", symbol = "ts_language_version")
fn ts_language_version(language: Int) -> Int [ffi]
